# Database Configuration
POSTGRES_DB=clipper_x
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/clipper_x
SYNC_DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/clipper_x

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
NODE_TOKEN_SECRET=clipper_x_production_token_secret_replace_in_prod

# Telemetry and Heartbeat Thresholds
HEARTBEAT_INTERVAL_SECONDS=30
STALE_AFTER_SECONDS=90
OFFLINE_AFTER_SECONDS=180
OFFLINE_CHECK_INTERVAL_SECONDS=10

# Bandwidth Limits (in MB)
BANDWIDTH_TEST_SIZE_MB=5
BANDWIDTH_MAX_UPLOAD_MB=10

# Network & Reverse Proxy Security
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Logging
LOG_LEVEL=INFO
